generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// JRAレース情報
model Race {
  id          String       @id @default(cuid())
  name        String
  date        DateTime
  venue       String
  grade       String       // G1, G2, G3, 通常
  surface     String       // 芝, ダート
  distance    Int
  analyzed       Boolean      @default(false)
  trackCondition String?      // 良/稍重/重/不良
  raceNumber     Int?         // R番号（1-12）
  netkeibaRaceId String?      @unique // 例: "202602010801"
  weather        String?      // 晴/曇/雨/雪
  startTime      String?      // "15:40"
  className      String?      // "新馬", "未勝利", "1勝クラス", "OP", "G3"など
  prizePool      Int?         // 1着賞金（万円）
  entries     RaceEntry[]
  results     RaceResult[]
  predictions Prediction[]
  analysisLog AnalysisLog?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([name, date])
  @@index([date, grade])
  @@index([analyzed])
  @@index([date, venue])
  @@index([className])
}

// 出走馬
model RaceEntry {
  id          String   @id @default(cuid())
  raceId      String
  race        Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horseNumber Int
  frameNumber Int?
  horseName   String
  age         Int?
  sex         String?
  weight      Float?
  horseWeight Int?
  jockey      String?
  trainer     String?
  odds        Float?
  popularity  Int?
  createdAt   DateTime @default(now())

  @@unique([raceId, horseNumber])
}

// レース結果
model RaceResult {
  id             String   @id @default(cuid())
  raceId         String
  race           Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  finishPosition Int?     // null = 取消・除外・中止
  horseNumber    Int
  horseName      String
  age            Int?
  sex            String?
  weight         Float?
  horseWeight    Int?
  weightChange   Int?     // 馬体重増減（例: +4, -2）
  jockey         String?
  trainer        String?
  time           String?
  margin         String?
  odds           Float?
  popularity     Int?
  scratchReason  String?  // "出走取消" | "競走除外" | "競走中止"
  cornerPositions String? // "1-1-1-1" コーナー通過順位
  passingTime    String?  // 途中ラップ
  rapidIncrease  Float?   // 上がり3F（秒）
  netkeibaHorseId String? // 馬個体ID
  createdAt      DateTime @default(now())

  @@unique([raceId, horseNumber])
  @@index([horseName])
  @@index([raceId, finishPosition])
  @@index([netkeibaHorseId])
}

// 予想結果
model Prediction {
  id          String   @id @default(cuid())
  raceId      String
  race        Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  horseNumber Int?
  horseName   String
  placeRate   Float
  rank        Int
  factors     Json?
  createdAt   DateTime @default(now())
}

// 分析ログ（自己学習の記録）
model AnalysisLog {
  id        String   @id @default(cuid())
  raceId    String   @unique
  race      Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  analysis  String   @db.Text
  insights  String?  @db.Text
  accuracy  Float?
  createdAt DateTime @default(now())
}

// 馬別成績統計（自己学習で蓄積→予想をClaude不要にする）
model HorseStat {
  id           String   @id @default(cuid())
  horseName    String   @unique
  totalRaces   Int      @default(0)
  totalPlaces  Int      @default(0)
  g1Races      Int      @default(0)
  g1Places     Int      @default(0)
  g2Races      Int      @default(0)
  g2Places     Int      @default(0)
  g3Races      Int      @default(0)
  g3Places     Int      @default(0)
  distanceData  Json     @default("{}")  // {"3200": {"races": 3, "places": 2}}
  venueData     Json     @default("{}")  // {"京都": {"races": 4, "places": 2}}
  surfaceData   Json     @default("{}")  // {"芝": {"races": 10, "places": 6}}
  raceNameData  Json     @default("{}")  // {"天皇賞（春）": {"races": 2, "places": 1}}
  trackCondData Json     @default("{}")  // {"良": {"races": 8, "places": 3}, "稍重": {"races": 2, "places": 1}}
  intervalData   Json     @default("{}")  // {"standard3": {"races": 4, "places": 2}} 出走間隔ビン別成績
  courseDistData Json     @default("{}")  // {"東京-芝-2400": {"races": 3, "places": 2}} 会場×馬場×距離複合
  avgHorseWeight     Float?            // §G 馬体重平均（全出走時の平均）
  weightSamples      Int      @default(0)  // §G 体重サンプル数
  // --- オッズ非依存の実力系特徴量（point-in-time, reanalyze.js が算出） ---
  bestSpeed          Float?            // 過去走スピード指数(z)の最良値（速い=高い）
  avgSpeed3          Float?            // 直近3走スピード指数の平均
  lastSpeed          Float?            // 直近走スピード指数
  avgPosRatio        Float?            // 1角通過位置/頭数の平均（0=前, 1=後）
  frontRate          Float?            // 先行率（pos_ratio<=0.3 の割合）
  bestR3f            Float?            // 過去走上がり3F最速（秒, 小=良）
  avgR3f3            Float?            // 直近3走上がり3F平均（秒）
  avgRecentPop       Float?            // 直近5走の人気平均（市場評価の代理, 小=人気）
  bestRecentPop      Int?              // 直近5走の最高人気（最小値）
  sireDistRate       Float?            // 父産駒の同距離帯連対率（point-in-time）
  sireSurfRate       Float?            // 父産駒の同馬場連対率
  bmsDistRate        Float?            // 母父産駒の同距離帯連対率
  recentForm         String?           // "1-2-1-3-2"
  recentGrades       String?           // "G1-G2-G3-G1-G2" (recentFormと対応するグレード列)
  recentPops         String?           // "1-3-8-2-5" (recentFormと対応する人気順位)
  lastRaceDate       DateTime?
  lastRacePopularity Int?              // 最終レース人気（叩き良化検出用）
  runningStyle       String?           // 脚質: 逃/先/差/追（展開予測用）
  sire               String?           // 父
  dam                String?           // 母
  sireOfSire         String?           // 父父
  sireOfDam          String?           // 母父（ブルードメアサイアー）
  damOfSire          String?           // 父母（父の母）
  damOfDam           String?           // 母母（母の母）
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// アルゴリズム設定（学習した予想思考）
model AlgorithmConfig {
  id            String   @id @default(cuid())
  version       Int
  isActive      Boolean  @default(false)
  rules         String   @db.Text
  insights      String?  @db.Text
  analyzedCount Int      @default(0)
  accuracy      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

// カレンダー駆動取り込みの進捗管理
model RaceCalendar {
  date         DateTime @id          // 開催日（00:00:00）
  totalRaces   Int                   // この日の総レース数
  fetchedRaces Int      @default(0)  // うち取込み完了
  status       String   @default("pending")  // pending/partial/done/error
  lastFetched  DateTime?
  errorLog     String?  @db.Text
}
